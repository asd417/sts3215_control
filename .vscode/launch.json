{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "driver_test.exe on servo",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/driver_test.exe",
            "args": ["${input:port}", "${input:id}"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build driver_test.exe",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "externalConsole": false
        },
        {
            "name": "driver_test.exe packet checks only",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/driver_test.exe",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build driver_test.exe",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "externalConsole": false
        }
    ],
    "inputs": [
        { "id": "port", "type": "promptString", "description": "COM port", "default": "COM11" },
        { "id": "id", "type": "promptString", "description": "servo ID", "default": "1" }
    ]
}
